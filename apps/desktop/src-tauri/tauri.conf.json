{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Shutter Hub",
  "version": "0.1.0",
  "identifier": "com.shutterhub.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Shutter Hub",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/thumbs/**"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEUyNDJFM0MzODM2MDE0QkMKUldTOEZHQ0R3K05DNHRxUkRZbnN0TWFjMDBRRTYwalNsNGhqV0JyS0tBaUpJNmtUMWFMa1BHQjgK",
      "endpoints": [
        "https://github.com/Tatekii/shutter-hub/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
